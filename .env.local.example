# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay (for checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Image Storage Strategy (choose ONE):
# Option 1: AWS S3 + CloudFront
# - Set USE_S3=true to use S3 for image storage with CloudFront CDN
# - Images uploaded via presigned URLs and served via CloudFront
# - Best for production with high traffic
USE_S3=false
AWS_S3_BUCKET=your-s3-bucket-name
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
AWS_S3_FRONTEND_BUCKET=your-frontend-bucket-name
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# Option 2: Cloudinary
# - Set USE_CLOUDINARY=true to use Cloudinary for image storage and transformations
# - Provides automatic image optimization and CDN
# - Good for rapid development and built-in transformations
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Option 3: Supabase Storage (default fallback)
# - Set USE_SUPABASE_STORAGE=true or leave both S3 and Cloudinary as false
# - Uses Supabase Storage buckets for image hosting
# - Free tier available, good for development and low-traffic sites
USE_SUPABASE_STORAGE=true
SUPABASE_STORAGE_BUCKET=product-images

# AWS SES Email Service (optional, set to 'true' to enable)
USE_AWS_SES=false
SES_FROM_EMAIL=noreply@yourdomain.com

# AWS SNS SMS Service (optional, set to 'true' to enable)
USE_AWS_SNS=false

# SMS Provider Configuration (sns or msg91)
SMS_PROVIDER=sns

# MSG91 Configuration (alternative to AWS SNS for India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=SAMARA
MSG91_TEMPLATE_ID=your_msg91_template_id
